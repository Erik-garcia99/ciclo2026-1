void parser_hora(uint32_t minutos, uint8_t set){


	char buffer[16];
	
    uint8_t horas = minutos / 60;
    uint8_t mins = minutos % 60;
	
	
	if(set != 1){
		
		//se parse ala hora para cunado se quiere apagar el led
		
		time_led.hora_down_led = horas;
		time_led.minutos_down_led = minutos;
		
		int len = snprintf(buffer, sizeof(buffer), "\n\rLED DOWN\n\r");
		uart_write_bytes(UART_NUM_0, buffer, len); //ahora lo que hacemos solo es imrpmrir lo que tenemos
		
		
	}else{
		
		//set es 1 por lol que se quiere parsear es la hora de prender el led, separamos las hora sya los minutos 
		time_led.hora_set_led = horas;
		time_led.minuto_set_led= minutos;
		int len = snprintf(buffer, sizeof(buffer), "\n\rLED SET\n\r");
		uart_write_bytes(UART_NUM_0, buffer, len); //ahora lo que hacemos solo es imrpmrir lo que tenemos
	}
	
	
